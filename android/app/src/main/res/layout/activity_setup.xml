<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mw_screen"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/setup_title"
            android:textColor="@color/mw_text"
            android:textSize="28sp"
            android:textStyle="bold"
            android:accessibilityHeading="true"
            tools:targetApi="28" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/setup_intro"
            android:textColor="@color/mw_muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/from_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/chip_bg"
            android:padding="12dp"
            android:text="@string/setup_from_link"
            android:textColor="@color/mw_text"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/field_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@+id/url"
                android:text="@string/setup_url"
                android:textColor="@color/mw_muted"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/chip_bg"
                android:hint="@string/setup_url_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:minHeight="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/mw_text"
                android:textColorHint="@color/mw_muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@+id/key"
                android:text="@string/setup_key"
                android:textColor="@color/mw_muted"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/chip_bg"
                android:fontFamily="monospace"
                android:hint="@string/setup_key_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:minHeight="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/mw_text"
                android:textColorHint="@color/mw_muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/setup_key_help"
                android:textColor="@color/mw_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/save"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/button_bg"
            android:stateListAnimator="@null"
            android:text="@string/setup_save"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center_horizontal"
            android:textColor="@color/mw_text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/field_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_add_title"
                android:textColor="@color/mw_text"
                android:textSize="17sp"
                android:textStyle="bold"
                android:accessibilityHeading="true"
            tools:targetApi="28" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/setup_add"
                android:textColor="@color/mw_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/pin"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_secondary_bg"
                android:stateListAnimator="@null"
                android:text="@string/setup_add_button"
                android:textAllCaps="false"
                android:textColor="@color/mw_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/setup_refresh_note"
                android:textColor="@color/mw_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/open"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/button_secondary_bg"
            android:stateListAnimator="@null"
            android:text="@string/setup_open"
            android:textAllCaps="false"
            android:textColor="@color/mw_accent"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
