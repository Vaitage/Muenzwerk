<?xml version="1.0" encoding="utf-8"?>
<!-- Adresse und Widget-Schlüssel nicht sichern und nicht auf andere Geräte übertragen -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
