# Copy to .env and adjust. / Nach .env kopieren und anpassen.

# Language of the default categories created on first start: en or de
# Sprache der Standardkategorien beim ersten Start: de oder en
# (The UI language follows the device and can be switched under "More".)
DEFAULT_LANGUAGE=en

# "demo" = made-up transactions to try things out
# "enablebanking" = real data from your bank via Enable Banking (PSD2)
# "none" = no bank yet ("Connect" reports "not set up", no demo data)
BANK_PROVIDER=demo

# Address the app is reachable at (used for the redirect back from the bank).
# With Tailscale e.g. https://muenzwerk.your-tailnet.ts.net
PUBLIC_URL=

# Host names the app answers to (comma-separated, * as wildcard).
# For a first test on your home network add the Pi's IP, e.g.: localhost,127.0.0.1,*.ts.net,192.168.178.50
ALLOWED_HOSTS=localhost,127.0.0.1,*.ts.net

# Show "More -> Updates" in the app (only with tools/pi/auto-update-einrichten.sh,
# and only in ONE installation per server – an update affects all of them)
# UPDATES_IN_APP=1

# How often new transactions are fetched automatically (hours, 0 = off)
SYNC_INTERVAL_HOURS=6

# Only for BANK_PROVIDER=enablebanking
ENABLEBANKING_APP_ID=
ENABLEBANKING_KEY_FILE=/data/enablebanking.pem
# Bank name and country exactly as listed by Enable Banking, e.g. ING / DE
ENABLEBANKING_BANK=ING
ENABLEBANKING_COUNTRY=DE
